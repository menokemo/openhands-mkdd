# Staging environment overrides for the auto-deploy system.
#
# These are the SAME alternate ports/names used in the manual isolation
# test performed on the VM on 2026-08-13 (mkdd-agent-canvas-TEST on
# 18000/13000, then mkdd-ui-TEST on 15173/18787) — reused here so the
# auto-deploy stack never collides with the production containers
# (openhands-agent-canvas on 8000/3000, mkdd-ui on 5173/8787).
#
# install.sh copies this file to $DEPLOY_DIR/.env, where `docker compose`
# picks it up automatically. It is NOT committed as $DEPLOY_DIR/.env itself
# (that file lives outside the repo and survives every `git reset --hard`,
# since untracked files are never touched by a hard reset).

# --- Ports (all different from the production defaults) ---
MKDD_AGENT_CANVAS_PORT=18000
MKDD_AGENT_CANVAS_UI_PORT=13000
MKDD_UI_PORT=15173
MKDD_UI_BACKEND_PORT=18787

# --- Container names (must differ, or `docker compose up` will refuse to
#     start a second container with a name already in use) ---
MKDD_AGENT_CANVAS_CONTAINER_NAME=openhands-agent-canvas-staging
MKDD_UI_CONTAINER_NAME=mkdd-ui-staging

# --- Image tag (must differ from mkdd/agent-canvas:1.12.0-mkdd2, which is
#     the tag the production container was built from — reusing it here
#     would silently overwrite that tag's contents on every staging build) ---
MKDD_AGENT_CANVAS_IMAGE=mkdd/agent-canvas:staging

# --- Named volume (must differ so staging never reads/writes the
#     production Agent Canvas state) ---
MKDD_STATE_VOLUME_NAME=openhands_agent_canvas_state_staging

# --- Compose project name: gives staging its own network namespace
#     (e.g. mkdd-staging_default) instead of sharing one with production ---
COMPOSE_PROJECT_NAME=mkdd-staging
